# ---------------------------------------------------------------------------
# Deploy Studio configuration. Copy to .env and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Public URL of the Deploy Studio admin app (its origin is used for CSRF/Origin checks)
APP_URL=http://localhost:3000

# MySQL 8 (metadata only). Use ssl=true in production; allowPublicKeyRetrieval only for local dev.
DATABASE_URL=mysql://deploy_studio:change-me@localhost:3306/deploy_studio?allowPublicKeyRetrieval=true

SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60

# --- Storage & upload limits ---
STORAGE_ROOT=./data/storage
UPLOAD_MAX_ARCHIVE_MB=50
UPLOAD_MAX_FILES=2000
UPLOAD_MAX_EXTRACTED_MB=200
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_RATIO=100

# --- Untrusted content origins (MUST be different hosts from APP_URL) ---
# Production example: https://sites.corp.example  and  https://preview.corp-preview.example
SITES_BASE_URL=http://sites.localhost:8080
PREVIEW_BASE_URL=http://preview.localhost:8080
# >= 32 random chars each, e.g. `openssl rand -base64 48`. Store in a secret manager in production.
GATEWAY_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Shared by web + worker (proxy health probes). >= 24 chars.
HEALTH_PROBE_TOKEN=replace-with-another-random-secret
PREVIEW_TTL_MINUTES=120
GATEWAY_COOKIE_MINUTES=60
# Optional: departments to create on `npm run db:seed` (labels, comma separated). Nothing is hard-coded.
SEED_DEPARTMENTS=

RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_PROMOTIONS_PER_HOUR=30
RATE_LIMIT_LOGINS_PER_10MIN=30

# --- Worker only ---
RUNTIME=docker
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=900
SITE_BASE_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine
SITES_NETWORK=ds-sites
SITE_CONTAINER_MEMORY=128m
SITE_CONTAINER_CPUS=0.25
SITE_CONTAINER_PIDS=64
ROUTES_DIR=./data/routes
PROXY_INTERNAL_URL=http://proxy:80
ROUTER_ENTRYPOINTS=web
ROUTER_TLS=false
MALWARE_SCAN_MODE=none
# Suspicious-script check: block (HIGH findings fail the upload) | warn | off
CONTENT_SCAN_MODE=block
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# e.g. trivy image --exit-code 1 --severity HIGH,CRITICAL {image}
IMAGE_SCAN_COMMAND=

# --- Accounts (local email/password; docs/authentication.md, docs/security/password-security.md) ---
# Corporate email domains that may be enrolled (comma separated, e.g. company.com). Required in production.
ALLOWED_EMAIL_DOMAINS=
# Minimum password length (owner policy: 8 + at least one letter and one digit). Never below 8.
PASSWORD_MIN_LENGTH=8
# Argon2id cost (OWASP minimum m=19456 KiB, t=2, p=1 — production refuses lower). Tune to ~200-500 ms per hash.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# One-time password setup/reset links handed over by an administrator (no email is sent).
PASSWORD_LINK_TTL_HOURS=24
# Failed sign-ins per account per 15 minutes before the account is temporarily locked.
RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=8
# Sensitive admin actions need a password confirmation newer than this many minutes.
ADMIN_STEP_UP_MAX_AGE_MINUTES=15
