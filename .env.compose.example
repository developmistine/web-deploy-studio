# Environment for `docker compose` (copy to .env.compose; also export the DB passwords for compose
# interpolation, e.g. `cp .env.compose.example .env.compose && set -a && . ./.env.compose && set +a`).
# Placeholders only — use a secret manager in production.

MYSQL_ROOT_PASSWORD=dev-root-password-change-me
DS_APP_PASSWORD=dev-app-password-change-me
DS_MIGRATE_PASSWORD=dev-migrate-password-change-me

NODE_ENV=production
APP_URL=http://studio.localhost:8080
SITES_BASE_URL=http://sites.localhost:8080
PREVIEW_BASE_URL=http://preview.localhost:8080
GATEWAY_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
HEALTH_PROBE_TOKEN=replace-with-another-random-secret
# Local compose uses *.localhost (same registrable "domain"); production must use separate domains.
REQUIRE_SEPARATE_SITE_DOMAINS=false

# Traefik templating
STUDIO_HOST=studio.localhost
STUDIO_UPSTREAM=http://web:3000
GATEWAY_AUTH_URL=http://web:3000/api/internal/gate

# Worker
RUNTIME=docker
SITE_BASE_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine
MALWARE_SCAN_MODE=none
# Suspicious-script check: block (HIGH findings fail the upload) | warn | off
CONTENT_SCAN_MODE=block
IMAGE_SCAN_COMMAND=

# --- Accounts (local email/password; docs/authentication.md, docs/security/password-security.md) ---
# Corporate email domains that may be enrolled (comma separated, e.g. company.com). Required in production.
ALLOWED_EMAIL_DOMAINS=
# Minimum password length (owner policy: 8 + at least one letter and one digit). Never below 8.
PASSWORD_MIN_LENGTH=8
# Argon2id cost (OWASP minimum m=19456 KiB, t=2, p=1 — production refuses lower). Tune to ~200-500 ms per hash.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# One-time password setup/reset links handed over by an administrator (no email is sent).
PASSWORD_LINK_TTL_HOURS=24
# Failed sign-ins per account per 15 minutes before the account is temporarily locked.
RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=8
# Sensitive admin actions need a password confirmation newer than this many minutes.
ADMIN_STEP_UP_MAX_AGE_MINUTES=15
